{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spyglass.dev/schemas/suggested-patch.v1.json",
  "title": "Patch suggéré Spyglass",
  "description": "runs/<runId>/suggested-patch.json. Jamais appliqué (F-57, ADR-0008). Lot 5 s'arrête à la production.",
  "type": "object",
  "required": ["schemaVersion", "runId", "sessionId", "applied", "patches"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "applied": { "const": false, "description": "Invariant Lot 5 : le patch n'est jamais auto-appliqué." },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stepIndex", "scope", "original", "suggested", "diagnosis", "confidence"],
        "additionalProperties": false,
        "properties": {
          "stepIndex": { "type": "integer", "minimum": 0 },
          "scope": { "const": "action.descriptor" },
          "original": { "$ref": "https://spyglass.dev/schemas/raw-event.v1.json#/$defs/replayDescriptor" },
          "suggested": { "$ref": "https://spyglass.dev/schemas/raw-event.v1.json#/$defs/replayDescriptor" },
          "diagnosis": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
