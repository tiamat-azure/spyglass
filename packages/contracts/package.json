{
  "name": "@spyglass/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Spyglass JSON schemas, types, and fixture validation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:schemas": "vitest run src/schema-fixtures.test.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
