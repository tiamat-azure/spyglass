{
  "name": "@spyglass/runner",
  "version": "0.0.0",
  "private": true,
  "description": "Spyglass scenario runner: deterministic replay, verification, bounded AI recovery (Lot 5, ADR-0006).",
  "type": "module",
  "bin": {
    "spyglass-run": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@spyglass/contracts": "workspace:*",
    "@spyglass/llm": "workspace:*",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
