{
  "name": "@spyglass/runner",
  "version": "0.0.0",
  "private": true,
  "description": "Spyglass scenario runner: deterministic replay, generated thin script, bounded AI recovery (Lots 5–6, ADR-0006).",
  "type": "module",
  "bin": {
    "spyglass-run": "./src/cli.ts",
    "spyglass-generate": "./src/generate-cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "measure-corpus": "node src/corpus-cli.ts"
  },
  "dependencies": {
    "@spyglass/contracts": "workspace:*",
    "@spyglass/llm": "workspace:*",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
