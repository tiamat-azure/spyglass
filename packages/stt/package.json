{
  "name": "@spyglass/stt",
  "version": "0.0.0",
  "private": true,
  "description": "Local whisper.cpp STT sidecar over localhost WebSocket (ADR-0004/0005/0013). Mock engine for CI.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sidecar": "node --experimental-strip-types src/cli.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
