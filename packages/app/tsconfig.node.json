{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "exactOptionalPropertyTypes": false,
    "outDir": "./out",
    "rootDir": "."
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/cdp-guest.mjs"
  ],
  "exclude": ["src/**/*.test.ts"]
}
