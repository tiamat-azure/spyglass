{
  "name": "spyglass",
  "version": "0.0.0",
  "private": true,
  "description": "Spyglass monorepo — Lot 6 generated script + Lot 5 runner + refine + voice + observer + capture + Electron shell",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.33.3"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "fix:sandbox": "node scripts/doctor.mjs --fix-sandbox",
    "predev": "node scripts/doctor.mjs",
    "dev": "pnpm --filter @spyglass/app dev",
    "prebuild": "node scripts/doctor.mjs --deps",
    "build": "pnpm -r --if-present build",
    "prestart": "node scripts/doctor.mjs",
    "start": "pnpm --filter @spyglass/app start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "pnpm --filter @spyglass/contracts test:coverage && pnpm --filter @spyglass/llm test:coverage",
    "test:schemas": "pnpm --filter @spyglass/contracts test:schemas",
    "test:e2e": "pnpm --filter @spyglass/app test:e2e",
    "test:packaged-observe": "pnpm --filter @spyglass/app test:packaged-observe",
    "package": "pnpm --filter @spyglass/app package",
    "capture:shell": "node scripts/capture-empty-shell.mjs",
    "capture:lot0": "node scripts/capture-lot-0.mjs",
    "observe": "node packages/app/scripts/stagehand-observe.mjs",
    "measure-corpus": "pnpm --filter @spyglass/runner measure-corpus"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
